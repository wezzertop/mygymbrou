# ==========================================
# MiGymBrou - Variables de Entorno (.env.local)
# Listo para desarrollo local, Supabase (nuevo formato) y Dokploy
# ==========================================

# URL pública de la aplicación (sin barra al final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Project URL (Supabase -> Project Settings -> Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Publishable API Key (Supabase -> Project Settings -> API Keys -> sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# 3. Secret API Key — SOLO servidor, nunca usar NEXT_PUBLIC_ (Supabase -> API Keys -> sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Modo Demo Interactivo (false en producción / cuando uses Supabase real)
NEXT_PUBLIC_DEMO_MODE=false
