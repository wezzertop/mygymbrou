# ==========================================
# MiGymBrou - Variables de Entorno (.env.local / Dokploy)
# Producción Ready: Next.js 15 + Supabase Auth + RLS + SMTP
# ==========================================

# URL pública de la aplicación en producción (sin barra final)
# Ejemplo producción: https://mygymbrou.nocodepy.com
NEXT_PUBLIC_SITE_URL=https://mygymbrou.nocodepy.com
NEXT_PUBLIC_APP_URL=https://mygymbrou.nocodepy.com

# 1. Project URL (Supabase -> Project Settings -> Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Clave Pública / Anon (puedes usar la nueva Publishable Key o la clásica Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# 3. Clave de Servicio / Secreta — SOLO servidor, NUNCA usar NEXT_PUBLIC_
# Necesaria para invitaciones de alumnos por correo y vinculación automática
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Modo Demo Interactivo (SIEMPRE false en producción)
NEXT_PUBLIC_DEMO_MODE=false

# ==========================================
# Datos Bancarios SPEI (Fase Beta / Pagos por Transferencia)
# ==========================================
NEXT_PUBLIC_SPEI_BANK=BBVA / STP (Configurar en Dokploy)
NEXT_PUBLIC_SPEI_BENEFICIARY=MiGymBrou México
NEXT_PUBLIC_SPEI_CLABE=0000 0000 0000 0000 00

# ==========================================
# Stripe Billing (Suscripciones MXN + Webhooks)
# ==========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs en Pesos Mexicanos (IVA + Stripe incluidos)
NEXT_PUBLIC_STRIPE_PRICE_BASE=price_coach_base_449_mxn
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_coach_pro_969_mxn
NEXT_PUBLIC_STRIPE_PRICE_STUDIO=price_estudio_gym_2199_mxn
